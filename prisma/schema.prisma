generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  THERAPIST
  PATIENT
  ATHLETE
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ExerciseCategory {
  STRENGTH
  MOBILITY
  PLYOMETRICS
  CARDIO
  STABILITY
}

enum BodyRegion {
  KNEE
  SHOULDER
  BACK
  ANKLE
  HIP
  FULL_BODY
  CERVICAL
  THORACIC
  LUMBAR
  ELBOW
  WRIST
  FOOT
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MediaType {
  UPLOAD
  YOUTUBE
  VIMEO
  // Gated/beveiligde hosting voor betaalde shop-content (signed playback).
  // videoUrl bevat dan de Mux playbackId resp. Cloudflare Stream UID.
  MUX
  CLOUDFLARE_STREAM
}

enum LoadType {
  BODYWEIGHT
  WEIGHTED
  MACHINE
  BAND
}

enum MovementPattern {
  SQUAT
  LUNGE
  HINGE
  PUSH_HORIZONTAL
  PUSH_VERTICAL
  PULL_HORIZONTAL
  PULL_VERTICAL
  HIP_THRUST
  CALF_RAISE
  CORE
  ROTATION
  ISOLATION_UPPER
  ISOLATION_LOWER
  CARRY
  FULL_BODY
}

enum SessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum ProgramType {
  STRENGTH
  MOBILITY
  PLYOMETRICS
  CARDIO
  STABILITY
  MIXED
}

enum CardioActivity {
  RUNNING
  CYCLING
  ROWING
  SWIMMING
  CROSSTRAINER
  WALKING
  SKIERG
  ASSAULT_BIKE
  WATTBIKE
  STAIRCLIMBER
  OTHER
}

enum CardioProtocol {
  STEADY_STATE
  INTERVALS
  TEMPO
  FARTLEK
  ZONE_TRAINING
  THRESHOLD
  LONG_SLOW_DISTANCE
  WALK_RUN
}

// ─── Clinical Insight Engine (CIE) ───────────────────────────────────────────

enum InsightUrgency {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum InsightStatus {
  OPEN
  FOLLOWED_UP
  DISMISSED
  SNOOZED
  EXPIRED
}

enum InsightActionType {
  VIEWED
  FOLLOWED_UP
  DISMISSED
  SNOOZED
  REOPENED
}

// ─── Revalidatie-protocollen (stoplicht-tracker) ─────────────────────────────

enum RehabCriterionStatusValue {
  NOT_MET // rood
  IN_PROGRESS // oranje — bijna
  MET // groen — behaald
}

enum RehabCriterionInputType {
  NUMERIC // bv 125 (graden), 95 (%), 20 (reps)
  TEXT // kwalitatief ("goed" / "matig" / "slecht")
  PASS_FAIL // slagen / niet slagen
}

// ─── Mobility Assessment (Ready State methodology) ───────────────────────────

enum AssessmentArchetype {
  LUMBAR_SPINE
  SQUAT_HINGE
  PISTOL
  LUNGE
  THORACIC_SPINE
  OVERHEAD
  FRONT_RACK
  PRESS
  HANG
  BREATHING
}

enum AssessmentTestType {
  ACTIVE
  PASSIVE
  MOTOR_CONTROL
  BREATHING
}

enum AssessmentScore {
  NOT_TESTED // grijs / overgeslagen
  FAIL // rood
  PARTIAL // oranje
  PASS // groen
}

enum TestConstruct {
  STRENGTH
  ROM
  POWER
  BALANCE
  ENDURANCE
  PROVOCATION
  NEURODYNAMIC
  MOVEMENT_QUALITY
  SENSORIMOTOR
  FUNCTIONAL
  SPORT_SPECIFIC
  SENSIBILITY
  RESPIRATORY
  EFFUSION
  DECISION_RULE
}

enum TissueLimitation {
  JOINT
  SLIDING_SURFACE
  MUSCLE_DYNAMICS
  MOTOR_CONTROL
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  // Stabiele binding aan de Supabase auth-user. Email is mutable; deze UUID
  // niet. Lookups in tRPC context gebeuren primair op deze kolom — fallback
  // op email-match alleen voor legacy rows zonder supabaseUserId, en alleen
  // als het een 1-op-1 match is (anders geweigerd, voorkomt account-takeover
  // via Supabase email-change).
  supabaseUserId String?   @unique
  name           String?
  role           UserRole  @default(PATIENT)
  avatarUrl      String?
  phone          String?
  dateOfBirth    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Therapist fields
  specialty       String?
  bio             String?
  licenseNumber   String?
  // Naam-split — naast `name` (canonical, voor backwards-compat) houden we
  // firstName/lastName apart. UI bewerkt firstName/lastName, server hercomputeert
  // `name = trim(firstName + ' ' + lastName)` om beide in sync te houden.
  // Backfill via SQL bij eerste migratie voor bestaande rows.
  firstName       String?
  lastName        String?
  // Functietitel — getoond in email-footer onder de therapeut-naam.
  // Bijv. "Sportfysiotherapeut", "Manueel therapeut".
  jobTitle        String?
  // Praktijk-eigenaarschap — onafhankelijk van `role`. Max één owner per
  // practice afgedwongen via partial unique index in SQL-migratie. Owner mag
  // praktijkgegevens (Practice) bewerken; andere therapeuten in dezelfde
  // praktijk hebben read-only toegang.
  isPracticeOwner Boolean @default(false)

  // Patient fields — blessure / injury info
  injuryInfo               String?
  injuryVisibleToTherapist Boolean @default(false)

  // Cardio HR-profiel — voor het auto-berekenen van hartslagzones (1-5) als
  // bpm-bereiken. maxHeartRate ontbreekt → fallback op leeftijd (208 - 0.7·jaar)
  // via dateOfBirth. restingHeartRate aanwezig → Karvonen (HRR), anders %HRmax.
  // lthr (lactaatdrempel-HR) optioneel, voor drempel-/zone-4-training.
  maxHeartRate     Int?
  restingHeartRate Int?
  lthr             Int?

  // DPA (Verwerkingsovereenkomst — AVG verplicht)
  dpaAcceptedVersion String?
  dpaAcceptedAt      DateTime?

  // Geheimhoudingsverklaring (GHV) — in-app acceptatie door THERAPIST vóór
  // dossier-toegang. Aanvullend op het getekende papieren exemplaar in het
  // personeelsdossier (DPIA actie 14); dit is de technische afdwinging.
  ghvAcceptedVersion String?
  ghvAcceptedAt      DateTime?

  // MFA
  mfaEnabled                    Boolean   @default(false)
  mfaSecret                     String?
  mfaEnforcedAt                 DateTime? // moment waarop admin/therapist rol MFA verplicht kreeg
  mfaLastBackupCodesGeneratedAt DateTime?

  // Admin-toegekende feature-flags (opt-in per therapeut).
  // Mobility Assessment (Ready State methodology) — admin schakelt per therapeut in.
  canUseAssessment Boolean @default(false)

  // Cohort analytics opt-in — patient/athlete moet expliciet aanvinken om
  // mee te tellen in platform-aggregaten (gemiddelden / trends voor therapeut
  // + admin). Default = niet meedoen, conform AVG art. 9 (bijzondere
  // persoonsgegevens vereisen expliciete toestemming).
  // Onafhankelijk van research consent: dat gaat over geanonimiseerd
  // onderzoeksdata-export, dit gaat over interne aggregaten binnen de practice.
  cohortAnalyticsOptIn Boolean @default(false)

  // AVG art. 17 — right to be forgotten
  deletedAt           DateTime? // soft-delete tombstone (records stay during 30-day grace)
  deletionRequestedAt DateTime? // when patient requested deletion

  // Multi-tenant: praktijk-scope. null = legacy / admin / cross-tenant.
  practiceId String?
  practice   Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)

  // Relations
  therapistPatients     PatientTherapist[]   @relation("TherapistRelation")
  patientTherapists     PatientTherapist[]   @relation("PatientRelation")
  createdPrograms       Program[]            @relation("ProgramCreator")
  patientPrograms       Program[]            @relation("ProgramPatient")
  exercises             Exercise[]
  collections           ExerciseCollection[]
  appointments          Appointment[]        @relation("PatientAppointments")
  therapistAppointments Appointment[]        @relation("TherapistAppointments")
  sessionLogs           SessionLog[]         @relation("SessionLogPatient")
  therapistSessionLogs  SessionLog[]         @relation("SessionLogTherapist")
  sessionMoves          SessionMove[]        @relation("SessionMovePatient")
  messageThread         Message[]            @relation("MessageThreadPatient")
  authoredMessages      Message[]            @relation("MessageAuthor")
  cardioLogs            CardioLog[]
  notifications         Notification[]
  createdWeekSchedules  WeekSchedule[]       @relation("CreatedWeekSchedules")
  patientWeekSchedules  WeekSchedule[]       @relation("PatientWeekSchedules")
  researchConsent       ResearchConsent?
  favoriteExercises     FavoriteExercise[]
  wellnessChecks        WellnessCheck[]
  painEntries           PainEntry[]
  invitesSent           InviteCode[]         @relation("InviteSender")
  auditLogs             AuditLog[]
  mfaBackupCodes        MfaBackupCode[]

  // CIE relations
  patientInsightStatus PatientInsightStatus?  @relation("PatientInsightStatusPatient")
  insightStatusEnabled PatientInsightStatus[] @relation("PatientInsightStatusEnabler")
  insights             Insight[]              @relation("InsightPatient")
  insightStatusChanges Insight[]              @relation("InsightStatusChanger")
  insightActions       InsightAction[]        @relation("InsightActionActor")
  insightPrefs         TherapistInsightPref?

  // Rehab-tracker relations
  rehabTracker           PatientRehabTracker?   @relation("RehabTrackerPatient")
  rehabTrackersActivated PatientRehabTracker[]  @relation("RehabTrackerActivator")
  rehabStatusUpdates     RehabCriterionStatus[] @relation("RehabStatusUpdater")

  // Educatie-content (admin-beheerd)
  educationalResources EducationalResource[] @relation("EducationalResourceCreator")

  // Mobility assessment relations
  assessmentsAsPatient   PatientAssessment[] @relation("AssessmentPatient")
  assessmentsAsTherapist PatientAssessment[] @relation("AssessmentTherapist")

  // Clinical-test library relations
  clinicalTestAssignments   PatientTestAssignment[] @relation("ClinicalTestPatient")
  clinicalTestsAssignedByMe PatientTestAssignment[] @relation("ClinicalTestAssigner")
  clinicalTestResultsLogged PatientTestResult[]     @relation("ClinicalTestResultPerformer")

  // Consumenten-shop: programma's waarvoor deze therapeut credit krijgt (omzetverdeling).
  shopProductsCredited   ShopProduct[] @relation("ShopProductTherapist")
  // Testrapport relations
  testReportsAsPatient   TestReport[]  @relation("TestReportPatient")
  testReportsAsTherapist TestReport[]  @relation("TestReportTherapist")

  // Hardloopanalyse relations
  runningAnalysesAsPatient   RunningAnalysis[] @relation("RunningAnalysisPatient")
  runningAnalysesAsTherapist RunningAnalysis[] @relation("RunningAnalysisTherapist")

  // Wearables (Apple Watch / HealthKit + Strava)
  wearableConnections WearableConnection[]
  stravaConnection    StravaConnection?
  sleepEntries        SleepEntry[]
  vitalsEntries       VitalsEntry[]
  readinessSnapshots  ReadinessSnapshot[]
  stressEntries       StressEntry[]

  @@index([deletedAt])
  @@map("users")
}

/// Eén-voor-één-bruikbare MFA recovery-codes. We slaan ALLEEN de hash op,
/// patient/therapist moet ze zelf bewaren (print / password-manager).
/// Bij `usedAt != null` is de code al verbrand en kan niet opnieuw.
model MfaBackupCode {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, usedAt])
  @@map("mfa_backup_codes")
}

model WellnessCheck {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  date      DateTime // start-of-day, 1 per user per day
  sleep     Int // 1-5 (5 = great sleep)
  soreness  Int // 1-5 (5 = no soreness)
  fatigue   Int // 1-5 (5 = fresh)
  mood      Int // 1-5 (5 = great)
  stress    Int // 1-5 (5 = calm)
  notes     String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
  @@map("wellness_checks")
}

model PainEntry {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  nrs        Int // 0-10 NRS pain scale
  location   String // e.g. "Knie links"
  context    String // 'rest' | 'movement' | 'exercise' | 'after' | 'always'
  notes      String?
  reportedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, reportedAt])
  @@map("pain_entries")
}

enum PatientAccessStatus {
  PENDING
  APPROVED
  DECLINED
  REVOKED
}

model PatientTherapist {
  id          String              @id @default(cuid())
  therapist   User                @relation("TherapistRelation", fields: [therapistId], references: [id], onDelete: Cascade)
  therapistId String
  patient     User                @relation("PatientRelation", fields: [patientId], references: [id], onDelete: Cascade)
  patientId   String
  createdAt   DateTime            @default(now())
  isActive    Boolean             @default(true)
  // Consent-workflow: patient moet expliciet toestemming geven. Bestaande
  // rijen krijgen default APPROVED om huidige koppelingen niet te breken.
  status      PatientAccessStatus @default(APPROVED)
  requestedAt DateTime?
  respondedAt DateTime?
  notes       String?

  @@unique([therapistId, patientId])
  @@map("patient_therapists")
}

model Exercise {
  id                 String           @id @default(cuid())
  name               String
  description        String?
  category           ExerciseCategory
  bodyRegion         BodyRegion[]
  difficulty         Difficulty       @default(BEGINNER)
  mediaType          MediaType?
  videoUrl           String?
  thumbnailUrl       String?
  instructions       String[]
  tips               String[]
  tags               String[]
  isPublic           Boolean          @default(false)
  loadType           LoadType         @default(BODYWEIGHT)
  isUnilateral       Boolean          @default(false)
  movementPattern    MovementPattern?
  trackOneRepMax     Boolean          @default(false)
  // Standaard-parameters die overgenomen worden wanneer deze oefening
  // aan een programma wordt toegevoegd. Vorm: ExtraParam[] uit
  // src/components/programs/types.ts.
  defaultExtraParams Json             @default("[]")
  // Standaard tracking-unit voor de primaire as (reps/sec/min). Wordt
  // overgenomen in ProgramExercise.repUnit bij toevoegen aan een programma.
  // "sec" voor isometrische oefeningen (plank/wall sit/dead hang).
  defaultRepUnit     String           @default("reps")
  createdBy          User             @relation(fields: [createdById], references: [id])
  createdById        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Muscle loading (1-5 per muscle group)
  muscleLoads MuscleLoad[]
  messages    Message[]

  // Progression variants (self-referential)
  easierVariantId String?
  easierVariant   Exercise?  @relation("ProgressionEasier", fields: [easierVariantId], references: [id])
  easierOf        Exercise[] @relation("ProgressionEasier")
  harderVariantId String?
  harderVariant   Exercise?  @relation("ProgressionHarder", fields: [harderVariantId], references: [id])
  harderOf        Exercise[] @relation("ProgressionHarder")

  programExercises          ProgramExercise[]
  collectionItems           ExerciseCollectionItem[]
  favoritedBy               FavoriteExercise[]
  insights                  Insight[]
  assessmentMobilizations   AssessmentTestMobilization[]
  weekScheduleItemExercises WeekScheduleDayItemExercise[]

  // Multi-tenant: oefening is zichtbaar binnen deze praktijk. null = globaal
  // (admin-beheerd / legacy). Gecombineerd met isPublic (true = ook globaal
  // zichtbaar) voor de resolution-regels.
  practiceId String?
  practice   Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)

  @@index([practiceId])
  @@map("exercises")
}

model Practice {
  id                String       @id @default(cuid())
  name              String
  // Adres + contact — alle nullable zodat bestaande praktijken niet breken.
  // Worden meegerenderd in de email-footer als ze ingevuld zijn; lege velden
  // worden in de footer overgeslagen, of de hele footer als de minimale set
  // (addressLine1 + city + email-of-phone) ontbreekt.
  addressLine1      String?
  addressLine2      String?
  postalCode        String?
  city              String?
  country           String?      @default("Nederland")
  phone             String?
  email             String?
  website           String?
  logoUrl           String?
  agbCodePractice   String?
  // Plain text, max 500 chars. Wordt onderaan de email-footer gerenderd in
  // kleinere grijze typografie. Geen HTML/markdown om XSS-risico in mail-
  // templates te vermijden.
  privacyDisclaimer String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  // Clinical Insight Engine — gefaseerde rollout per praktijk.
  cieEnabled        Boolean      @default(false)
  users             User[]
  exercises         Exercise[]
  inviteCodes       InviteCode[]

  @@map("practices")
}

/// Physitrack-achtige invite-flow: therapeut genereert een 6-cijfer code,
/// mailt die naar de patiënt. Patiënt logt in met e-mail + geboortejaar + code.
/// Only codeHash is stored — klare code bestaat alleen tijdens de request.
model InviteCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  email         String
  name          String
  dateOfBirth   DateTime // full date; alleen year wordt gecontroleerd bij redeem
  role          UserRole  @default(PATIENT)
  practiceId    String?
  practice      Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  invitedById   String
  invitedBy     User      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  usedAt        DateTime?
  usedByUserId  String? // link naar de aangemaakte/bestaande User na redeem
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([email])
  @@index([invitedById])
  @@index([expiresAt])
  @@map("invite_codes")
}

/// AVG art. 32 — audit-trail van kritieke acties (login, data-view, consent, export, delete).
/// Nooit patient-vrije PII direct in metadata; alleen IDs + event-type.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorEmail String? // fallback als user verwijderd is
  event      String // bv. LOGIN_SUCCESS, INVITE_CREATED, DATA_EXPORTED
  resource   String? // bv. 'Patient', 'Program', 'SessionLog'
  resourceId String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model FavoriteExercise {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId String
  createdAt  DateTime @default(now())

  @@unique([userId, exerciseId])
  @@index([userId])
  @@map("favorite_exercises")
}

model MuscleLoad {
  id         String   @id @default(cuid())
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId String
  muscle     String // e.g. "Quadriceps", "Hamstrings"
  load       Int // 1-5

  @@unique([exerciseId, muscle])
  @@map("muscle_loads")
}

model ExerciseCollection {
  id          String   @id @default(cuid())
  name        String
  color       String? // hex color label
  therapist   User     @relation(fields: [therapistId], references: [id])
  therapistId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ExerciseCollectionItem[]

  @@map("exercise_collections")
}

model ExerciseCollectionItem {
  id           String             @id @default(cuid())
  collection   ExerciseCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  exercise     Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId   String
  addedAt      DateTime           @default(now())

  @@unique([collectionId, exerciseId])
  @@map("exercise_collection_items")
}

model Program {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProgramStatus @default(DRAFT)
  type        ProgramType   @default(STRENGTH)
  isTemplate  Boolean       @default(false)
  weeks       Int           @default(4)
  daysPerWeek Int           @default(3)
  startDate   DateTime?
  endDate     DateTime?

  // Na hoeveel weken zónder wijziging het schema een controle-signaal voor de
  // therapeut oplevert. Null = standaard (8 weken, zie lib/program-review.ts).
  // De klok telt vanaf `updatedAt`: elke aanpassing reset 'm.
  reviewAfterWeeks Int?
  cardioParams     Json? // CardioParams JSONB for cardio programs

  tendinopathyMode Boolean @default(false)
  trackOneRepMax   Boolean @default(false)

  // Flexible-schedule modus: patient kan dit programma elke dag van de week
  // starten in plaats van vastgepind op specifieke dagen. Klaar zodra de
  // patient `weeklyTarget` keer voltooid heeft (Mo-Su rolling). Resulteert
  // in een "lekker bezig" melding aan patient-zijde + suppressie van de
  // oefeningen voor de rest van die week.
  flexibleSchedule Boolean @default(false)
  weeklyTarget     Int?

  creator   User    @relation("ProgramCreator", fields: [creatorId], references: [id])
  creatorId String
  patient   User?   @relation("ProgramPatient", fields: [patientId], references: [id], onDelete: Cascade)
  patientId String?

  // Multi-tenant scope — defensief. Null = legacy (van vóór practice-scoping).
  practiceId String?

  exercises            ProgramExercise[]
  resources            ProgramResource[]
  sessionLogs          SessionLog[]
  weekScheduleDays     WeekScheduleDay[]
  weekScheduleDayItems WeekScheduleDayItem[] @relation("ProgramWeekScheduleItems")
  cardioLogs           CardioLog[]
  // Consumenten-shop: dit template kan als betaald product worden verkocht.
  shopProducts         ShopProduct[]
  sessionMoves         SessionMove[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([practiceId])
  @@index([creatorId, practiceId])
  @@map("programs")
}

// Berichten tussen patiënt/atleet en behandelend therapeut(en): één draad per
// patiënt, leesbaar voor collega-therapeuten in dezelfde praktijk (zelfde
// scope als andere patiënt-data; authorId is de audit-trail van wie wat
// schreef). Een bericht kan optioneel gekoppeld zijn aan een gelogde sessie
// en/of een oefening ("vond deze echt zwaar" bij de deadlift van week 3).
model Message {
  id           String      @id @default(cuid())
  patient      User        @relation("MessageThreadPatient", fields: [patientId], references: [id], onDelete: Cascade)
  patientId    String
  author       User        @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId     String
  body         String
  sessionLog   SessionLog? @relation(fields: [sessionLogId], references: [id], onDelete: SetNull)
  sessionLogId String?
  exercise     Exercise?   @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  exerciseId   String?
  // True = geschreven door de patiënt zelf (authorId == patientId). Denormaal
  // maar maakt ongelezen-tellingen mogelijk zonder kolom-vergelijking.
  fromPatient  Boolean     @default(false)
  // Gelezen door de andere kant van het gesprek (patiënt ⇄ praktijk).
  readAt       DateTime?
  createdAt    DateTime    @default(now())

  @@index([patientId, createdAt])
  @@map("messages")
}

// Sessie verplaatsen binnen de week: patiënt/atleet schuift een geplande
// programma-dag naar een andere weekdag. Eén rij per (patiënt, programma,
// week, fromDay); verplaatsen overschrijft, terugzetten verwijdert de rij.
model SessionMove {
  id        String   @id @default(cuid())
  patient   User     @relation("SessionMovePatient", fields: [patientId], references: [id], onDelete: Cascade)
  patientId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId String
  week      Int
  fromDay   Int // programma-dag (1-7) die verschoven wordt
  toDay     Int // weekdag (1=ma .. 7=zo) waarop de sessie gepland staat
  createdAt DateTime @default(now())

  @@unique([patientId, programId, week, fromDay])
  @@map("session_moves")
}

model CardioLog {
  id              String         @id @default(cuid())
  program         Program?       @relation(fields: [programId], references: [id], onDelete: SetNull)
  programId       String?
  patient         User           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId       String
  activity        CardioActivity
  protocol        CardioProtocol
  durationSec     Int // seconds
  distanceM       Int? // meters
  avgHeartRate    Int?
  maxHeartRate    Int?
  zone            Int? // 1-5 (behaalde gemiddelde zone)
  targetZone      Int? // 1-5 (voorgeschreven doel-zone, los van behaalde `zone`)
  calories        Int?
  rpe             Int? // 1-10 (bij watch/Strava eerst uit HR geschat; door de gebruiker overschreven bij beoordelen)
  feelScore       Int? // 1-5 subjectieve voldoening/gevoel (uit de beoordeel-popup)
  // Gezet zodra de gebruiker de activiteit heeft beoordeeld (RPE/gevoel/notitie).
  // NULL = nog niet beoordeeld → gesyncte activiteiten met NULL triggeren de popup.
  ratedAt         DateTime?
  painLevel       Int? // 0-10
  notes           String?
  intervals       Json? // werkelijk gelogde interval-breakdown [{ label, type, durationSec, distanceM?, avgHeartRate? }]
  // Tijd-in-zone (seconden per HR-zone): { "1": sec, "2": sec, ... }. Afgeleid
  // uit gemeten HR + het HR-profiel van de patiënt op moment van loggen.
  timeInZones     Json?
  // Per-minuut tijdreeks van de wearable-sync: [{ t: sec-vanaf-start, hr: bpm|null,
  // spd: m/s|null }]. Voedt de HR/tempo-grafiek + cardiac-decoupling op het
  // activity-scherm. Alleen gevuld voor gesyncte workouts met samples.
  series          Json?
  avgPaceSecPerKm Int? // gemiddeld tempo in s/km (afgeleid uit distanceM/durationSec, opgeslagen voor trends)
  // Bron van de sessie: handmatig gelogd of gesynct vanuit een wearable.
  // `externalId` = HealthKit-workout-UUID; uniek PER PATIËNT zodat overlappende
  // sync-batches (na anchor-reset / herinstallatie) niet dubbel landen, en zodat
  // een handmatig gelogde sessie niet dubbelt met dezelfde watch-workout.
  // Scope = (patientId, externalId), NIET globaal: een door de client
  // aangeleverde UUID mag nooit de rij van een ándere patiënt raken.
  source          WorkoutSource  @default(MANUAL)
  externalId      String?
  completedAt     DateTime       @default(now())
  createdAt       DateTime       @default(now())

  @@unique([patientId, externalId])
  @@index([patientId, completedAt])
  @@map("cardio_logs")
}

model WeekSchedule {
  id          String            @id
  name        String
  description String?
  creatorId   String
  creator     User              @relation("CreatedWeekSchedules", fields: [creatorId], references: [id])
  patientId   String?
  patient     User?             @relation("PatientWeekSchedules", fields: [patientId], references: [id], onDelete: Cascade)
  startDate   DateTime?
  endDate     DateTime?
  isTemplate  Boolean           @default(false)
  // weekNumber = 1, 2, 3, ... voor multi-week behandelplannen per patient.
  // Bestaande records behouden 1 (default). Templates negeren dit veld.
  weekNumber  Int               @default(1)

  // ── Periodisering (per-week metadata) ──────────────────────────────────────
  // Trainingsfase/blok van deze week — vrije string, maar de UI kent de vaste
  // set ACCUMULATION | INTENSIFICATION | REALIZATION | DELOAD | TAPER en geeft
  // die een label + kleur. Null = geen fase toegewezen.
  phaseType   String?
  // Deload-week: minder volume/intensiteit. Los van phaseType zodat je ook
  // binnen een blok een losse deload kunt markeren.
  isDeload    Boolean           @default(false)
  // Geplande weekbelasting (sRPE-stijl punten) — richtwaarde die de planner
  // naast de gerealiseerde belasting toont. Null = geen doel gezet.
  targetLoad  Int?
  // Week-brede coaching-notitie (doel/aandachtspunt voor deze week).
  weekNote    String?

  days        WeekScheduleDay[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Multi-tenant scope. Null = legacy.
  practiceId String?

  @@index([practiceId])
  @@index([creatorId, practiceId])
  @@map("week_schedules")
}

model WeekScheduleDay {
  id             String                @id
  weekScheduleId String
  weekSchedule   WeekSchedule          @relation(fields: [weekScheduleId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  // Legacy: 1 programma per dag. Behouden voor backward-compat met patient-app
  // die nog deze shape leest. Vervangen door `items[]` voor multi-workout —
  // wordt in latere fase verwijderd nadat alle consumers gemigreerd zijn.
  programId      String?
  program        Program?              @relation(fields: [programId], references: [id])
  // Multi-workout per dag: 0..N losse items per dag (programma's of "snelle"
  // workouts zonder programma-koppeling).
  items          WeekScheduleDayItem[]

  @@map("week_schedule_days")
}

/// Eén workout binnen een dag — kan een gekoppeld programma zijn (variant A)
/// of een losse "snelle workout" (variant B, TP-stijl) zonder oefeningen.
/// Exact één van `programId` of `quickCategory` is gevuld; de andere set is null.
model WeekScheduleDayItem {
  id    String          @id @default(cuid())
  day   WeekScheduleDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId String
  // Volgorde binnen de dag — laagste eerst gerenderd.
  order Int             @default(0)

  // Variant A: koppeling aan bestaand programma uit de bibliotheek.
  programId String?
  program   Program? @relation("ProgramWeekScheduleItems", fields: [programId], references: [id], onDelete: SetNull)

  // Variant B: losse "snelle" workout zonder programma — type, naam, duur.
  // quickCategory hergebruikt de bestaande ExerciseCategory enum (STRENGTH,
  // MOBILITY, PLYOMETRICS, CARDIO, STABILITY) zodat de UI de juiste
  // kleur/icoon kan kiezen, zonder een nieuwe enum te introduceren.
  quickCategory    ExerciseCategory?
  quickName        String?
  quickDurationSec Int?

  // Optionele therapeut-notitie bij dit specifieke item.
  notes String?

  // Inline-opgebouwde oefeningen voor een quick-workout (los van een programma).
  exercises WeekScheduleDayItemExercise[]

  // Cardio-parameters voor een quick CARDIO-workout (type/duur/afstand/zone/
  // intervallen). JSON-vorm beheerd in de UI.
  cardioParams Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayId, order])
  @@map("week_schedule_day_items")
}

// Oefening binnen een quick-workout-item (inline planner-builder). Los van
// ProgramExercise zodat een planner-workout lichtgewicht oefeningen kan dragen
// zonder een volledig Program aan te maken.
model WeekScheduleDayItemExercise {
  id         String              @id @default(cuid())
  item       WeekScheduleDayItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     String
  exercise   Exercise            @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId String

  order    Int     @default(0)
  sets     Int     @default(3)
  reps     Int     @default(10)
  repUnit  String  @default("reps")
  restTime Int?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId, order])
  @@map("week_schedule_day_item_exercises")
}

// Gestructureerd intensiteits-voorschrift op een ProgramExercise. Vervangt
// het loggen-van-losse-kg-en-1RM-schatten-achteraf door een expliciet doel
// dat de session-runner toont en (waar mogelijk) omrekent naar kg. Zo wordt
// een RPE-/percentage-gestuurd schema deelbaar en door de app aangestuurd,
// i.p.v. als vrije tekst in `notes`.
//   NONE               = geen expliciet voorschrift (gebruik notes)
//   RPE                = doel-RPE, intensityMin..intensityMax (bv. 7..8)
//   PERCENT_1RM        = percentage van (geschatte) 1RM, intensityMin..intensityMax (bv. 70..75)
//   RELATIVE_DAILY_MAX = kg-offset t.o.v. de zwaarste set van dezelfde oefening
//                        eerder in deze sessie (de "daily max"), intensityMin = offset (bv. -10)
//   TECHNIQUE          = techniek-only, geen belasting (bv. lege stang opbouw)
//   TEXT               = vrij voorschrift in intensityText (bv. "Eigen keuze — anti-rotatie")
enum IntensityType {
  NONE
  RPE
  PERCENT_1RM
  RELATIVE_DAILY_MAX
  TECHNIQUE
  TEXT
}

model ProgramExercise {
  id            String   @id @default(cuid())
  program       Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId     String
  exercise      Exercise @relation(fields: [exerciseId], references: [id])
  exerciseId    String
  week          Int      @default(1)
  day           Int      @default(1)
  order         Int      @default(0)
  sets          Int      @default(3)
  // Optionele bovengrens voor sets-range. NULL = `sets` als vaste waarde,
  // ingevuld = "sets..setsMax" als range (bv. 3-5 sets).
  setsMax       Int?
  reps          Int      @default(10)
  // Optionele bovengrens voor reps-range. NULL = enkele waarde, ingevuld = range.
  repsMax       Int?
  repUnit       String   @default("reps")
  restTime      Int      @default(60)
  supersetGroup String?
  supersetOrder Int      @default(0)
  notes         String?

  // Extra voorschrift-parameters per oefening in dit programma (Tempo, Gewicht,
  // Afstand, Hartslag, Moeite, Band kleur, …). Vorm:
  //   [{ id, label, type, value, unit?, options?, min?, max?, valueMax? }, ...]
  // Anders dan ExerciseLog.extraParams (gelogde waarden van de patiënt) en
  // Exercise.defaultExtraParams (template-defaults) draagt dit de door de
  // therapeut ingestelde doel-waarden voor dít programma.
  extraParams   Json?

  // Intensiteits-voorschrift — zie enum IntensityType hierboven. min/max dragen
  // afhankelijk van type een RPE-waarde, percentage of kg-offset; intensityText
  // is de vrije voorschrift-tekst bij TEXT/TECHNIQUE.
  intensityType IntensityType @default(NONE)
  intensityMin  Float?
  intensityMax  Float?
  intensityText String?

  @@map("program_exercises")
}

model SessionLog {
  id            String        @id @default(cuid())
  program       Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  programId     String?
  patient       User          @relation("SessionLogPatient", fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  // Null = patient logde de sessie zelf (via patient-app). Bij therapist-live-log
  // staat hier de behandelend therapeut. SetNull omdat een verwijderde therapeut
  // de historie van de patient niet mag cascade-deleten.
  therapist     User?         @relation("SessionLogTherapist", fields: [therapistId], references: [id], onDelete: SetNull)
  therapistId   String?
  status        SessionStatus @default(PENDING)
  scheduledAt   DateTime
  completedAt   DateTime?
  // False = patiënt is eerder gestopt (niet alle oefeningen afgevinkt bij
  // afronden). Status blijft COMPLETED zodat workload/historie-queries de
  // sessie blijven meetellen; de week-planner kleurt 'm oranje (deels).
  completedAll  Boolean       @default(true)
  duration      Int? // seconds
  notes         String?
  painLevel     Int? // 0-10
  exertionLevel Int? // 0-10 RPE
  feelScore     Int? // 1-5 subjectief gevoel sessie (1=slecht .. 5=top); null = niet ingevuld

  exerciseLogs ExerciseLog[]
  messages     Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([therapistId])
  @@map("session_logs")
}

model ExerciseLog {
  id                 String     @id @default(cuid())
  session            SessionLog @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId          String
  exerciseId         String
  setsCompleted      Int?
  repsCompleted      Int?
  repUnit            String? // 'reps' | 'sec' | 'min' | 'm'; null = legacy = reps. Onthoudt de eenheid voor lastUsedParams.
  duration           Int?
  notes              String?
  painLevel          Int?
  weight             Float? // kg used in last set (legacy single-weight)
  weightsPerSet      Json? // [number|null, ...] één entry per set
  repsPerSet         Json? // [number|null, ...] één entry per set; null = legacy = repsCompleted voor elke set
  extraParams        Json? // [{ id, label, type, value, unit?, options?, min?, max? }, ...]
  supersetGroup      String? // 'A'..'F' of null
  phase              String? // 'WARMUP' of 'MAIN' (null = legacy = MAIN)
  estimatedOneRepMax Float? // Epley: weight × (1 + reps/30)
  painDuring         Int? // 0-10 NRS, tendinopathy mode
  painAfter24h       Int? // 0-10 NRS, filled via follow-up
  morningStiffness   Int? // 0-10, filled via follow-up

  @@map("exercise_logs")
}

model Appointment {
  id          String            @id @default(cuid())
  patient     User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  patientId   String
  therapist   User              @relation("TherapistAppointments", fields: [therapistId], references: [id], onDelete: Cascade)
  therapistId String
  status      AppointmentStatus @default(SCHEDULED)
  scheduledAt DateTime
  duration    Int // minutes
  notes       String?
  location    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("appointments")
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  type      String
  data      Json?
  createdAt DateTime @default(now())

  @@map("notifications")
}

// ─── Research / GDPR ──────────────────────────────────────────────────────────

model ResearchConsent {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentGiven   Boolean   @default(false)
  consentVersion String    @default("1.0")
  consentGivenAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("research_consents")
}

// SECURITY: AnonymousIdMapping is NEVER exposed via API or tRPC.
// Only server-side functions may read/write this table.
model AnonymousIdMapping {
  id          String   @id @default(cuid())
  userId      String   @unique
  anonymousId String   @unique @default(cuid())
  createdAt   DateTime @default(now())

  @@map("anonymous_id_mappings")
}

model AnonymizedRecord {
  id                String   @id @default(cuid())
  // anonymousId references AnonymousIdMapping.anonymousId — no direct FK to prevent reverse lookup
  anonymousId       String
  recordDate        DateTime
  ageAtRecord       Int // computed from dateOfBirth at time of recording; DOB not stored
  diagnosisCategory String? // normalized diagnosis category (e.g. "ACL", "Schouder impingement")
  exerciseName      String?
  setsCompleted     Int?
  repsCompleted     Int?
  sessionDuration   Int? // seconds
  painLevel         Int? // 0-10
  exertionLevel     Int? // 0-10 RPE
  promData          Json? // PROM scores placeholder
  createdAt         DateTime @default(now())

  @@map("anonymized_records")
}

// ─── Clinical Insight Engine (CIE) ───────────────────────────────────────────
// Rule-based suggestion engine for therapists. Patients never see insights.
// See supabase/migrations/20260501_clinical_insight_engine.sql for RLS.

/// Opt-in tracking per patient + patient-objection flag (AVG art. 21).
/// One row per patient; absence = not-yet-enabled.
model PatientInsightStatus {
  patientId            String    @id
  patient              User      @relation("PatientInsightStatusPatient", fields: [patientId], references: [id], onDelete: Cascade)
  enabled              Boolean   @default(false)
  enabledById          String?
  enabledBy            User?     @relation("PatientInsightStatusEnabler", fields: [enabledById], references: [id])
  enabledAt            DateTime?
  disabledAt           DateTime?
  patientObjection     Boolean   @default(false)
  patientObjectionAt   DateTime?
  patientObjectionNote String?
  updatedAt            DateTime  @updatedAt

  @@map("patient_insight_status")
}

/// Generated insight row — one per detected trigger.
/// patientId-scoped (NOT therapist-scoped) so all treating therapists see the same.
model Insight {
  id                String         @id @default(cuid())
  patientId         String
  patient           User           @relation("InsightPatient", fields: [patientId], references: [id], onDelete: Cascade)
  signalType        String // matches InsightRule.signalType
  urgency           InsightUrgency
  title             String
  suggestion        String
  triggerData       Json // explainability payload — what data triggered this
  exerciseId        String?
  exercise          Exercise?      @relation(fields: [exerciseId], references: [id])
  status            InsightStatus  @default(OPEN)
  statusChangedById String?
  statusChangedBy   User?          @relation("InsightStatusChanger", fields: [statusChangedById], references: [id])
  statusChangedAt   DateTime?
  snoozedUntil      DateTime?
  createdAt         DateTime       @default(now())
  expiresAt         DateTime

  actions InsightAction[]

  @@index([patientId, status, urgency, createdAt])
  @@index([patientId, createdAt])
  @@index([patientId, signalType, createdAt])
  @@map("insights")
}

/// Audit trail — every therapist action on an insight.
/// note is ALWAYS optional (no accountability burden on therapist).
model InsightAction {
  id          String            @id @default(cuid())
  insightId   String
  insight     Insight           @relation(fields: [insightId], references: [id], onDelete: Cascade)
  therapistId String
  therapist   User              @relation("InsightActionActor", fields: [therapistId], references: [id])
  action      InsightActionType
  note        String?
  createdAt   DateTime          @default(now())

  @@index([insightId, createdAt])
  @@index([therapistId, createdAt])
  @@map("insight_actions")
}

/// Per-therapist CIE config: which signals, custom thresholds, quiet hours.
model TherapistInsightPref {
  therapistId       String   @id
  therapist         User     @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  signalsEnabled    Json     @default("{}") // { pain_flare: true, plateau: false, ... }
  customThresholds  Json     @default("{}") // { pain_flare: { delta: 2 }, ... }
  notificationPrefs Json     @default("{}") // { critical: ["email","push"], high: ["digest"] }
  quietHoursStart   Int? // 0-23 local hour
  quietHoursEnd     Int? // 0-23 local hour
  updatedAt         DateTime @updatedAt

  @@map("therapist_insight_prefs")
}

/// Rule catalog — seeded with 6 rules for v1. Therapists override via TherapistInsightPref.
model InsightRule {
  signalType      String         @id
  category        String // "pain" | "progression" | "adherence" | "pattern"
  defaultUrgency  InsightUrgency
  defaultConfig   Json
  evidenceRefs    String[]
  enabledGlobally Boolean        @default(true)
  updatedAt       DateTime       @updatedAt

  @@map("insight_rules")
}

// ─── Revalidatie-protocollen (catalog + per-patient tracker) ─────────────────
// Therapist-facing tracker voor fasegebonden revalidatie-criteria (stoplicht-UI).
// Admin beheert de catalog (RehabProtocol/Phase/Criterion); therapeut activeert
// per patient en vinkt criteria R/O/G af.

/// Admin-beheerd protocol uit een evidence-based bron (bv Melbourne VKB 2.0).
model RehabProtocol {
  id              String   @id @default(cuid())
  key             String   @unique // stabiele seed-key, bv "melbourne-acl-2"
  name            String
  description     String?
  specialty       String // "knee_acl", "meniscus", "shoulder"...
  sourceReference String? // bv "Cooper & Hughes (2024). Melbourne VKB Protocol 2.0"
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  phases   RehabPhase[]
  trackers PatientRehabTracker[]

  @@map("rehab_protocols")
}

/// E\u00e9n fase binnen een protocol (bv "Fase 2 \u2014 Kracht en Neuromusculaire Controle").
model RehabPhase {
  id               String        @id @default(cuid())
  protocolId       String
  protocol         RehabProtocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  order            Int // 0 = pre-op, 1..N = reguliere fases
  shortName        String // bv "Pre-op", "Fase 1"
  name             String // volledige naam
  description      String?
  keyGoals         String[] // 3 belangrijkste doelen als bullets
  // Indicatieve tijdlijn t.o.v. operatie (weken). Negatieve waarde = pre-op.
  // null = niet van toepassing / doorlopend.
  typicalStartWeek Int?
  typicalEndWeek   Int?

  criteria RehabCriterion[]

  @@unique([protocolId, order])
  @@map("rehab_phases")
}

/// Een afvinkbaar criterium/uitkomstmaat binnen een fase.
model RehabCriterion {
  id              String                  @id @default(cuid())
  phaseId         String
  phase           RehabPhase              @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  order           Int
  name            String // bv "Passieve Knie Flexie"
  testDescription String // hoe de test uit te voeren
  reference       String? // bv "Norkin & White, 1995"
  targetValue     String // doel als tekst, bv ">125\u00b0" of "90% vs contralateral"
  targetUnit      String? // "\u00b0", "%", "reps", "seconden"
  inputType       RehabCriterionInputType @default(NUMERIC)
  isBonus         Boolean                 @default(false)

  // Bilaterale kracht-metingen met auto-stoplicht:
  //   * isBilateral=true   \u2192 therapeut vult L + R waarde in, systeem berekent LSI
  //   * newtonMinGreen     \u2192 absolute minimum Newton-waarde per zijde voor GROEN
  //   * newtonMinOrange    \u2192 absolute minimum Newton-waarde per zijde voor ORANJE (onder = rood)
  //   * lsiMinGreen        \u2192 minimum LSI% (min/max * 100) voor GROEN (typisch 90)
  //   * lsiMinOrange       \u2192 minimum LSI% voor ORANJE (typisch 80)
  // Status wordt GROEN als BEIDE N\u2265Green \u00e9n LSI\u2265Green. ORANJE als N\u2265Orange + LSI\u2265Orange.
  isBilateral     Boolean @default(false)
  newtonMinGreen  Int?
  newtonMinOrange Int?
  lsiMinGreen     Int?
  lsiMinOrange    Int?

  statuses RehabCriterionStatus[]

  @@unique([phaseId, order])
  @@map("rehab_criteria")
}

/// Per-patient activation van \u00e9\u00e9n protocol tegelijk (toggle + dropdown).
model PatientRehabTracker {
  patientId     String        @id
  patient       User          @relation("RehabTrackerPatient", fields: [patientId], references: [id], onDelete: Cascade)
  protocolId    String
  protocol      RehabProtocol @relation(fields: [protocolId], references: [id])
  activatedById String
  activatedBy   User          @relation("RehabTrackerActivator", fields: [activatedById], references: [id])
  activatedAt   DateTime      @default(now())
  deactivatedAt DateTime?
  // Operatiedatum: basis voor indicatieve fase-berekening (week-based).
  surgeryDate   DateTime?
  // Optioneel: datum van blessure (voor pre-op contextualisering).
  injuryDate    DateTime?
  notes         String?
  updatedAt     DateTime      @updatedAt

  @@map("patient_rehab_trackers")
}

/// Per patient \u00d7 criterium de R/O/G status + meetwaarde + datum.
model RehabCriterionStatus {
  id               String                    @id @default(cuid())
  patientId        String
  criterionId      String
  criterion        RehabCriterion            @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  status           RehabCriterionStatusValue @default(NOT_MET)
  measurementValue String? // vrije tekst: "128\u00b0", "95%", "22 reps"
  measurementDate  DateTime?
  notes            String?
  updatedById      String
  updatedBy        User                      @relation("RehabStatusUpdater", fields: [updatedById], references: [id])
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([patientId, criterionId])
  @@index([patientId])
  @@map("rehab_criterion_status")
}

// ─── Educatie-content ────────────────────────────────────────────────────────
// Gecureerde patiënt-educatie: video's (extern of upload) en PDF-documenten,
// bv. een uitleg van het volledige ACL-traject om door te lezen. Admin-beheerd
// en globaal zichtbaar (geen practiceId). Optioneel gekoppeld aan een rehab-
// `specialty` (zelfde vocabulaire als RehabProtocol.specialty) zodat content
// automatisch bij de juiste patiënten verschijnt; specialty=null = algemeen.

enum EducationFormat {
  VIDEO
  PDF
}

model EducationalResource {
  id           String          @id @default(cuid())
  title        String
  description  String?
  format       EducationFormat
  // VIDEO: mediaType + videoUrl, zelfde conventie als Exercise.
  mediaType    MediaType?
  videoUrl     String?
  // PDF: object-pad binnen de privé-bucket `educational-resources`. Niet
  // publiek leesbaar — serveren via een server-side signed URL.
  filePath     String?
  thumbnailUrl String?
  // Matcht RehabProtocol.specialty ("knee_acl", "shoulder", …). null = algemeen.
  specialty    String?
  bodyRegion   BodyRegion[]
  tags         String[]
  isActive     Boolean         @default(true)
  order        Int             @default(0)
  createdBy    User            @relation("EducationalResourceCreator", fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  programItems ProgramResource[]

  @@index([specialty])
  @@index([isActive])
  @@map("educational_resources")
}

/// Koppeling van een educatie-resource aan een specifieke dag/week van een
/// programma (de "Leer"-blokken in de builder). Parallel aan ProgramExercise,
/// maar zonder oefening-parameters — alleen positie + ordening.
model ProgramResource {
  id         String              @id @default(cuid())
  program    Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId  String
  resource   EducationalResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId String
  week       Int                 @default(1)
  day        Int                 @default(1)
  order      Int                 @default(0)

  @@index([programId])
  @@map("program_resources")
}

// ─── Mobility Assessment (The Ready State methodology) ───────────────────────
// Catalog van ~55 tests verdeeld over 10 archetypes. Therapeut neemt een
// assessment-sessie af en scoort elke test Pass/Partial/Fail. Bij FAIL worden
// 3 voorgestelde mobilisaties getoond (gekoppeld aan Exercise-catalog).

/// Catalog: \u00e9\u00e9n test-definitie (archetype + type + beschrijving + criteria).
model AssessmentTest {
  id          String              @id @default(cuid())
  key         String              @unique
  archetype   AssessmentArchetype
  testType    AssessmentTestType
  name        String
  description String // hoe de test uit te voeren
  criteria    String // wat pass eruit ziet (bullets joined met \\n\u2022 )
  order       Int // sort-order binnen archetype
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  suggestedMobilizations AssessmentTestMobilization[]
  scores                 AssessmentTestScore[]

  @@index([archetype, testType, order])
  @@map("assessment_tests")
}

/// 3 voorgestelde mobilisaties per test (voor als deze FAIL is).
model AssessmentTestMobilization {
  id         String         @id @default(cuid())
  testId     String
  test       AssessmentTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order      Int // 0, 1, 2

  @@unique([testId, order])
  @@map("assessment_test_mobilizations")
}

/// E\u00e9n assessment-sessie per datum per patient.
model PatientAssessment {
  id          String   @id @default(cuid())
  patientId   String
  patient     User     @relation("AssessmentPatient", fields: [patientId], references: [id], onDelete: Cascade)
  therapistId String
  therapist   User     @relation("AssessmentTherapist", fields: [therapistId], references: [id])
  performedAt DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scores             AssessmentTestScore[]
  archetypeSummaries AssessmentArchetypeSummary[]

  @@index([patientId, performedAt])
  @@map("patient_assessments")
}

/// Score per test binnen een assessment-sessie.
model AssessmentTestScore {
  id           String            @id @default(cuid())
  assessmentId String
  assessment   PatientAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  testId       String
  test         AssessmentTest    @relation(fields: [testId], references: [id])
  score        AssessmentScore   @default(NOT_TESTED)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([assessmentId, testId])
  @@index([assessmentId])
  @@map("assessment_test_scores")
}

/// Per-archetype samenvatting + programming template binnen een assessment.
model AssessmentArchetypeSummary {
  id                        String              @id @default(cuid())
  assessmentId              String
  assessment                PatientAssessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  archetype                 AssessmentArchetype
  compensationStrategy      String?
  primaryTissue             TissueLimitation?
  // Programming Template — vrije tekst
  mobilityJoint             String?
  mobilitySlidingSurface    String?
  mobilityLoadedEndRange    String?
  motorSkillTransfer        String?
  motorMovementModification String?
  updatedAt                 DateTime            @updatedAt

  @@unique([assessmentId, archetype])
  @@map("assessment_archetype_summaries")
}

// ─── Clinical Tests library ──────────────────────────────────────────────────
// Eigenstandig model parallel aan RehabProtocol/RehabCriterion. Een test kan
// los aan een patient worden toegewezen via PatientTestAssignment, of (later)
// als criterium binnen een protocol-fase gebruikt worden. Library wordt
// geseed uit `scripts/clinical-tests-data.ts` (idempotent op `key`).

/// Eén klinische test in de library. Global — niet per practice gescoped.
model ClinicalTest {
  id               String        @id @default(cuid())
  /// Stabiele kebab-case slug, gebruikt als seed-key en URL-segment.
  key              String        @unique
  name             String
  alternativeNames String[] // eponymen, varianten — voor zoek
  bodyRegion       BodyRegion[] // primaire + secundaire regio's
  /// Vrije-tekst tags voor sub-regio's niet in de BodyRegion-enum
  /// (bv "SI_JOINT", "GROIN", "CORE"). Enum-uitbreiding zou te veel
  /// downstream-code raken; tags zijn flexibel genoeg voor filtering.
  tags             String[]
  construct        TestConstruct
  /// Wat de test meet (1 zin).
  shortGoal        String
  /// Hoe uitvoeren — concreet voor therapeut.
  execution        String
  /// Cut-off / benchmark / interpretatie als vrije tekst.
  benchmark        String
  /// Pathologieën / situaties waar test toegepast wordt.
  applicableTo     String[]
  /// Fase-codes 1–5 waarin test typisch wordt ingezet.
  phases           Int[]
  /// PubMed IDs van primaire bronnen.
  sourcePmids      String[]
  /// Level of Evidence (Oxford CEBM) 1–5.
  loE              Int
  /// Materiaal benodigd (optioneel).
  materialRequired String[]
  /// Geschatte test-tijd in minuten.
  estimatedTimeMin Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  assignments PatientTestAssignment[]

  @@index([construct])
  @@map("clinical_tests")
}

/// Eén losse test toegewezen aan een patient (los van program/protocol).
/// Een test kan meerdere keren toegewezen worden (longitudinaal hertest);
/// `assignedAt` maakt elke toewijzing uniek.
model PatientTestAssignment {
  id             String       @id @default(cuid())
  patientId      String
  patient        User         @relation("ClinicalTestPatient", fields: [patientId], references: [id], onDelete: Cascade)
  clinicalTestId String
  clinicalTest   ClinicalTest @relation(fields: [clinicalTestId], references: [id], onDelete: Cascade)
  assignedById   String
  assignedBy     User         @relation("ClinicalTestAssigner", fields: [assignedById], references: [id])
  assignedAt     DateTime     @default(now())
  dueDate        DateTime?
  notes          String?

  results PatientTestResult[]

  @@unique([patientId, clinicalTestId, assignedAt])
  @@index([patientId])
  @@index([clinicalTestId])
  @@map("patient_test_assignments")
}

/// Meetwaarden van één uitvoering van een toegewezen test.
/// Bilaterale tests vullen `leftValue` + `rightValue` en optioneel `lsi`.
/// Unilaterale of categoriale tests gebruiken het vrije-tekstveld `value`.
model PatientTestResult {
  id            String                @id @default(cuid())
  assignmentId  String
  assignment    PatientTestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  performedAt   DateTime              @default(now())
  performedById String
  performedBy   User                  @relation("ClinicalTestResultPerformer", fields: [performedById], references: [id])
  /// Vrije tekst, bv "128°", "95%", "22 reps", "graad 2+", "Pass".
  value         String?
  leftValue     Float?
  rightValue    Float?
  /// Limb-Symmetry Index (min/max × 100). Mag client-side berekend
  /// of door therapeut overruled worden.
  lsi           Float?
  painScore     Int?
  notes         String?
  createdAt     DateTime              @default(now())

  @@index([assignmentId])
  @@map("patient_test_results")
}

// ============================================================================
// CONSUMENTEN-SHOP / E-COMMERCE
// ----------------------------------------------------------------------------
// Losse oefenschema's verkopen aan consumenten + AI-intake. Deelt bewust de
// content-database (Exercise/Program), maar houdt PERSOONSDATA van kopers
// strikt gescheiden van klinische PHI: een koper is een ShopCustomer, GEEN
// patiënt — geen behandelrelatie, geen dossier, geen DPA-gating.
// Alle tabellen: RLS + default_deny in de bijbehorende SQL-migratie (anon-key
// zit in de browserbundle — zie AGENTS.md).
// ============================================================================

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELED
  REFUNDED
}

enum IntakeStatus {
  IN_PROGRESS
  COMPLETED
  RED_FLAGGED
}

/// Soort verkoopbaar product in de catalogus.
///  - PROGRAM  = digitaal trainingsschema (koppelt aan een Program-template).
///  - PHYSICAL = tastbaar artikel (merchandise): voorraad + verzending.
///  - SERVICE  = dienst, bv. hardloopanalyse of consult: boeking i.p.v. levering.
enum ProductKind {
  PROGRAM
  PHYSICAL
  SERVICE
}

/// Afhandelstatus voor fysieke bestellingen. NONE voor digitale producten.
enum FulfillmentStatus {
  NONE
  PENDING
  SHIPPED
  DELIVERED
}

/// Een koper. Los van het klinische User-model. Auth loopt via Supabase (OTP)
/// maar resolved naar dit model, niet naar User.
model ShopCustomer {
  id             String   @id @default(cuid())
  email          String   @unique
  supabaseUserId String?  @unique
  name           String?
  marketingOptIn Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders         ShopOrder[]
  entitlements   ShopEntitlement[]
  intakeSessions ShopIntakeSession[]

  @@map("shop_customers")
}

/// Een verkoopbaar product in de catalogus. `kind` bepaalt het soort: een
/// digitaal schema (PROGRAM, wrapt een Program-template), een fysiek artikel
/// (PHYSICAL, met voorraad + verzending) of een dienst (SERVICE, bv. een
/// hardloopanalyse). Zichtbaarheid in de shop wordt bepaald door `status`
/// (NIET door Exercise.isPublic, dat iets anders betekent).
model ShopProduct {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  tagline     String?
  description String?
  kind        ProductKind   @default(PROGRAM)
  status      ProductStatus @default(DRAFT)

  // PROGRAM: wat de koper verkrijgt is toegang tot dit Program-template
  // (gedeelde db). Leeg voor PHYSICAL/SERVICE.
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  programId String?

  // Therapeut die credit krijgt voor dit programma — basis voor omzetverdeling.
  therapist   User?   @relation("ShopProductTherapist", fields: [therapistId], references: [id], onDelete: SetNull)
  therapistId String?

  // Prijs in centen (EUR); btw apart zodat we netto/bruto kunnen tonen.
  priceCents Int
  currency   String @default("EUR")
  vatRate    Int    @default(21)

  // Verkooppresentatie
  level           Difficulty?
  durationWeeks   Int?
  bodyRegion      BodyRegion[]
  heroImageUrl    String?
  previewVideoUrl String?
  highlights      String[]

  // Grounding voor de AI-intake matcher (vrije tags, bv "hardlopen","beginner").
  intakeTags String[]

  // PHYSICAL: tastbaar artikel. stockQty null = voorraad niet bijgehouden.
  sku              String?
  stockQty         Int?
  requiresShipping Boolean @default(false)
  weightGrams      Int?

  // SERVICE: dienst (bv. hardloopanalyse). Boeking i.p.v. levering.
  bookingUrl String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants       ShopProductVariant[]
  orderItems     ShopOrderItem[]
  entitlements   ShopEntitlement[]
  intakeSessions ShopIntakeSession[]  @relation("IntakeRecommendedProduct")

  @@index([status])
  @@index([kind])
  @@map("shop_products")
}

/// Variant van een (meestal fysiek) product: maat, sterkte of kleur. priceCents
/// en stockQty null = neem de waarde van het product. Klaar voor gebruik; de
/// admin-editor vult dit in een vervolgstap.
model ShopProductVariant {
  id         String      @id @default(cuid())
  product    ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  label      String
  sku        String?
  priceCents Int?
  stockQty   Int?
  sortOrder  Int         @default(0)

  orderItems ShopOrderItem[]

  @@index([productId])
  @@map("shop_product_variants")
}

/// Een bestelling. Eén Mollie-betaling, één of meer items.
model ShopOrder {
  id          String       @id @default(cuid())
  customer    ShopCustomer @relation(fields: [customerId], references: [id])
  customerId  String
  email       String
  status      OrderStatus  @default(PENDING)
  amountCents Int
  currency    String       @default("EUR")

  molliePaymentId String? @unique

  // Naam van de koper (voor op de factuur).
  buyerName String?

  // Factuur: opvolgend nummer + moment van uitgifte (gezet bij betaling).
  invoiceNumber String?   @unique
  invoicedAt    DateTime?

  // Verzending (alleen relevant bij fysieke items). NONE voor puur digitale orders.
  shippingName       String?
  shippingAddress    String?
  shippingPostalCode String?
  shippingCity       String?
  shippingCountry    String?
  shippingCents      Int               @default(0)
  fulfillmentStatus  FulfillmentStatus @default(NONE)
  trackingUrl        String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items        ShopOrderItem[]
  entitlements ShopEntitlement[]

  @@index([customerId])
  @@index([status])
  @@map("shop_orders")
}

model ShopOrderItem {
  id           String              @id @default(cuid())
  order        ShopOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  product      ShopProduct         @relation(fields: [productId], references: [id])
  productId    String
  variant      ShopProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId    String?
  quantity     Int                 @default(1)
  // Snapshots op moment van aankoop (prijs/naam kunnen later wijzigen).
  priceCents   Int
  nameSnapshot String

  @@index([orderId])
  @@map("shop_order_items")
}

/// Toegangsrecht: deze klant mag dit product/programma gebruiken.
model ShopEntitlement {
  id         String       @id @default(cuid())
  customer   ShopCustomer @relation(fields: [customerId], references: [id])
  customerId String
  product    ShopProduct  @relation(fields: [productId], references: [id])
  productId  String
  order      ShopOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId    String?
  grantedAt  DateTime     @default(now())
  revokedAt  DateTime?

  @@unique([customerId, productId])
  @@index([customerId])
  @@map("shop_entitlements")
}

/// AI-intake sessie. Kan anoniem starten; rode-vlaggen-screening vóór advies.
/// AVG: `answers` kan gezondheidsdata bevatten (art. 9) — alleen met
/// toestemming bewaren; retentie/anonimisering nog te bepalen.
model ShopIntakeSession {
  id         String        @id @default(cuid())
  customer   ShopCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?

  status       IntakeStatus @default(IN_PROGRESS)
  answers      Json         @default("{}")
  redFlagged   Boolean      @default(false)
  consentGiven Boolean      @default(false)

  recommendedProduct   ShopProduct? @relation("IntakeRecommendedProduct", fields: [recommendedProductId], references: [id], onDelete: SetNull)
  recommendedProductId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("shop_intake_sessions")
}

// ─── Testrapport (Return to Sport / voortgangsmeting) ────────────────────────
// Een momentopname-rapport dat de behandelaar samenstelt uit losse tests met
// links/rechts-waarden, een doelzone-balk (rood/oranje/groen) en een marker.
// Catalogus = herbruikbare test-definities (vooraf as/zones/eenheid); een test
// kan via een batterij in één keer worden toegevoegd. Per rapport-entry zijn
// alle velden overschrijfbaar. Interpretatie + vervolgadvies worden (AI-)concept
// geschreven en door de behandelaar geredigeerd. Rendert naar PDF via
// `src/lib/pdf/testReport.ts`. Zone-logica leeft in `src/lib/test-report/compute.ts`.

/// BILATERAL = links + rechts ingevuld (LSI mogelijk). SINGLE = één waarde.
enum TestKind {
  BILATERAL
  SINGLE
}

/// Welke waarde op de doelzone-balk geplot wordt.
///   LSI   → min/max × 100 (symmetrie-index, plot-eenheid %)
///   RIGHT → de rechterwaarde zelf (bv geopereerde zijde, of ratio)
///   LEFT  → de linkerwaarde zelf
///   VALUE → de enkelvoudige waarde (SINGLE tests)
enum PlotMetric {
  LSI
  RIGHT
  LEFT
  VALUE
}

/// Doelzone waarin de geplotte waarde valt.
enum TestZone {
  RED
  ORANGE
  GREEN
}

enum TestReportStatus {
  DRAFT
  FINAL
}

/// Herbruikbare test-definitie met as + zone-drempels + eenheden.
/// Global library (niet practice-gescoped, net als ClinicalTest/AssessmentTest);
/// reads via service_role in de backend. Geseed uit scripts/test-catalog-data.ts.
model TestCatalogItem {
  id             String     @id @default(cuid())
  /// Stabiele kebab-case slug — idempotente seed-key.
  key            String?    @unique
  /// Praktijk-scope. NULL = globale seed-test (voor iedereen zichtbaar);
  /// gevuld = door een therapeut in die praktijk aangemaakt. Reads: NULL OF
  /// eigen practiceId. Writes: alleen binnen eigen praktijk (globale items
  /// zijn in de single-clinic realiteit ook bewerkbaar — zie router).
  practiceId     String?
  /// Therapeut die de test aanmaakte (audit); NULL voor seeds.
  creatorId      String?
  category       String // "Kracht", "Power", "Mobiliteit"
  categoryOrder  Int        @default(0)
  name           String // "Quadriceps"
  subtitle       String? // "isometrisch"
  source         String? // "KINVENT K-PULL · ISOMETRISCH"
  kind           TestKind   @default(BILATERAL)
  metric         PlotMetric @default(LSI)
  unitPrimary    String? // "kg", "cm", "sec", "reps", "°"
  unitSecondary  String? // "Nm/kg" (optionele tweede eenheid per zijde)
  plotUnit       String     @default("%") // eenheid van de geplotte waarde
  axisMin        Float      @default(60)
  axisMax        Float      @default(100)
  zoneOrangeMin  Float      @default(80) // ≥ → minimaal oranje
  zoneGreenMin   Float      @default(90) // ≥ → groen
  higherIsBetter Boolean    @default(true)
  order          Int        @default(0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  batteryItems  TestBatteryItem[]
  reportEntries TestReportEntry[]

  @@index([category, order])
  @@index([practiceId])
  @@map("test_catalog_items")
}

/// Test-batterij: een benoemde set tests om in één keer aan een rapport toe te
/// voegen (bv "Return to Sport · VKB"). Global library.
model TestBattery {
  id          String   @id @default(cuid())
  key         String?  @unique
  /// Praktijk-scope, zelfde semantiek als TestCatalogItem.practiceId.
  practiceId  String?
  /// Therapeut die de batterij aanmaakte (audit); NULL voor seeds.
  creatorId   String?
  name        String
  description String?
  /// Looptijd van de batterij als revalidatie-protocol, in weken. NULL = geen
  /// tijdlijn (losse meet-batterij). Gevuld → per test kan een targetWeek gezet
  /// worden waarin het doel behaald zou moeten zijn.
  durationWeeks Int?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items TestBatteryItem[]

  @@index([practiceId])
  @@map("test_batteries")
}

model TestBatteryItem {
  id            String          @id @default(cuid())
  batteryId     String
  battery       TestBattery     @relation(fields: [batteryId], references: [id], onDelete: Cascade)
  catalogItemId String
  catalogItem   TestCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  order         Int             @default(0)
  /// Week (t.o.v. start protocol) waarin het doel voor deze test behaald zou
  /// moeten zijn. NULL = geen week-doel. Alleen zinvol als battery.durationWeeks
  /// gezet is.
  targetWeek    Int?

  @@unique([batteryId, catalogItemId])
  @@map("test_battery_items")
}

/// Eén testrapport (momentopname) voor een patient.
model TestReport {
  id                String           @id @default(cuid())
  patientId         String
  patient           User             @relation("TestReportPatient", fields: [patientId], references: [id], onDelete: Cascade)
  therapistId       String
  therapist         User             @relation("TestReportTherapist", fields: [therapistId], references: [id])
  performedAt       DateTime         @default(now())
  // Kop-velden (vrije tekst per rapport)
  measurementNumber Int? // 3 → "Meting 03"
  subtitle          String? // "Objectieve meting van kracht, power en mobiliteit"
  trajectLabel      String? // "van revalidatietraject"
  location          String? // "NDSM"
  injuryGoal        String? // "VKB-reconstructie rechts · hamstringpees · terug naar voetbal"
  rehabPhaseLabel   String? // "Fase 3 · kracht & power · maand 5"
  // Slottekst
  interpretation    String? // vrije prozatekst (alinea's met \n\n)
  nextTestMoment    String? // "Over 6 weken · medio juli 2026 (maand 6,5)"
  nextTestGoal      String? // "LSI > 90% op alle krachttesten"
  status            TestReportStatus @default(DRAFT)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  entries TestReportEntry[]
  advice  TestReportAdvice[]

  @@index([patientId, performedAt])
  @@map("test_reports")
}

/// Eén test (met waarden) binnen een rapport. Spec-velden zijn gekopieerd uit
/// de catalogus bij toevoegen en daarna vrij overschrijfbaar.
model TestReportEntry {
  id                   String           @id @default(cuid())
  reportId             String
  report               TestReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  catalogItemId        String? // herkomst (nullable: vrije entry)
  catalogItem          TestCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  // Spec
  category             String
  categoryOrder        Int              @default(0)
  name                 String
  subtitle             String?
  source               String?
  kind                 TestKind         @default(BILATERAL)
  metric               PlotMetric       @default(LSI)
  unitPrimary          String?
  unitSecondary        String?
  plotUnit             String           @default("%")
  axisMin              Float            @default(60)
  axisMax              Float            @default(100)
  zoneOrangeMin        Float            @default(80)
  zoneGreenMin         Float            @default(90)
  higherIsBetter       Boolean          @default(true)
  // Waarden
  leftPrimary          Float?
  rightPrimary         Float?
  leftSecondary        Float?
  rightSecondary       Float?
  singleValue          Float?
  textValue            String? // categoriaal/vrij (niet geplot)
  // Overrides (null = automatisch berekend)
  plottedValueOverride Float?
  zoneOverride         TestZone?
  notes                String?
  order                Int              @default(0)

  @@index([reportId])
  @@map("test_report_entries")
}

/// Eén vervolgadvies-bullet (vette aanhef + tekst).
model TestReportAdvice {
  id       String     @id @default(cuid())
  reportId String
  report   TestReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  order    Int        @default(0)
  title    String // "Quadriceps zwaarder belasten."
  body     String

  @@index([reportId])
  @@map("test_report_advice")
}

// ─── Hardloopanalyse (2D videoanalyse) ───────────────────────────────────────
// Tweede assessment-type naast de Mobility Assessment. Vast standaardformulier:
// 6 achteraanzicht-beoordelingen (score 0-100, paren L/R), 6 zijaanzicht-
// hoekmetingen (ideale range met groene band) en 6 loopmetrics. Opmerkingen +
// vervolgadvies worden (AI-)concept geschreven en geredigeerd. Items worden bij
// aanmaken aangemaakt uit de vaste catalogus in `src/lib/running-analysis/catalog.ts`.
// Rendert naar PDF via `src/lib/pdf/runningAnalysis.ts`.

enum RunningViewSection {
  REAR // achteraanzicht — score 0-100, hoger is beter
  SIDE // zijaanzicht — hoekmeting binnen ideale range
}

enum RunningAnalysisStatus {
  DRAFT
  FINAL
}

model RunningAnalysis {
  id                String                @id @default(cuid())
  patientId         String
  patient           User                  @relation("RunningAnalysisPatient", fields: [patientId], references: [id], onDelete: Cascade)
  therapistId       String
  therapist         User                  @relation("RunningAnalysisTherapist", fields: [therapistId], references: [id])
  performedAt       DateTime              @default(now())
  // Kop
  goal              String? // "Blessurevrij 10 km"
  location          String?
  subtitle          String? // "Beoordeling van houding, beweging en loopmetrics"
  viewLabel         String? // "Achteraanzicht & zijaanzicht"
  // Loopmetrics (vaste 6 — gemiddelde over de analyse)
  cadence           Float? // stappen/min
  strideLength      Float? // paslengte, meter
  stepLength        Float? // staplengte, meter (stride)
  groundContact     Float? // seconde
  flightTime        Float? // seconde
  dutyFactor        Float? // ratio
  // Slottekst
  therapistComments String?
  nextMoment        String? // "Over 6 weken · medio juli 2026"
  status            RunningAnalysisStatus @default(DRAFT)
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  items  RunningAnalysisItem[]
  advice RunningAnalysisAdvice[]

  @@index([patientId, performedAt])
  @@map("running_analyses")
}

/// Eén beoordeeld item binnen een analyse (achter- of zijaanzicht).
/// REAR: `value` = score 0-100. SIDE: `value` = hoek in graden, met
/// idealMin/idealMax (groene band) + axisMin/axisMax voor de balk.
model RunningAnalysisItem {
  id         String             @id @default(cuid())
  analysisId String
  analysis   RunningAnalysis    @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  section    RunningViewSection
  key        String // "linker-heup", "overstride", ...
  label      String
  value      Float?
  comment    String?
  // Alleen SIDE: ideale range + as (gekopieerd uit de catalogus bij aanmaken).
  idealMin   Float?
  idealMax   Float?
  axisMin    Float?
  axisMax    Float?
  unit       String?
  order      Int                @default(0)

  @@unique([analysisId, key])
  @@index([analysisId])
  @@map("running_analysis_items")
}

/// Eén vervolg-bullet (vette aanhef + tekst).
model RunningAnalysisAdvice {
  id         String          @id @default(cuid())
  analysisId String
  analysis   RunningAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  order      Int             @default(0)
  title      String
  body       String

  @@index([analysisId])
  @@map("running_analysis_advice")
}

// ─── Wearables (Apple Watch / HealthKit) ─────────────────────────────────────
//
// De iOS-app (Expo dev-client) leest HealthKit met anchored queries en POST't
// batches naar /api/wearable/sync. Alles is idempotent op de HealthKit-sample-
// UUID (`externalId`) zodat overlappende batches — na anchor-reset of
// herinstallatie — niet dubbel landen.
//
// HRV-let op: Apple meet SDNN, andere wearables RMSSD; die zijn NIET
// vergelijkbaar. We bewaren daarom altijd `hrvType` en vergelijken uitsluitend
// binnen-persoon/binnen-device-trends t.o.v. een eigen baseline.

enum WearableProvider {
  APPLE_HEALTH
  STRAVA // Strava API (cloud-to-cloud, OAuth 2.0 + activity/stream-pull)
}

enum WorkoutSource {
  MANUAL // handmatig gelogd in de app
  APPLE_WATCH // gesynct vanuit HealthKit
  STRAVA // gesynct via de Strava API (OAuth 2.0 + activity/stream-pull)
}

enum HrvType {
  SDNN // Apple Watch
  RMSSD // Garmin / Whoop / Oura (toekomst)
}

enum ReadinessBand {
  GREEN // klaar voor (zware) training
  AMBER // onderhoud, niet opbouwen
  RED // deload / actief herstel
  LEARNING // < baseline-drempel aan nachten — nog niet betrouwbaar
}

/// Verbinding van een gebruiker met een wearable-bron. Eén rij per
/// (user, provider). `anchors` bewaart per HealthKit-type de laatste
/// incrementele anchor (opaque), zodat de native bridge incrementeel synct.
model WearableConnection {
  id          String           @id @default(cuid())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  provider    WearableProvider @default(APPLE_HEALTH)
  enabled     Boolean          @default(true)
  deviceModel String? // bv. "Apple Watch Series 9"
  anchors     Json? // { "workouts": "...", "sleep": "...", "hrv": "...", ... }
  connectedAt DateTime         @default(now())
  lastSyncAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@map("wearable_connections")
}

/// Strava OAuth 2.0-koppeling per user. Access-token verloopt (6u); refresh-token
/// haalt een nieuw op. `athleteId` = Strava-athlete-id (mapping/dedup).
model StravaConnection {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String    @unique
  athleteId    String    @unique // Strava athlete-id (als string; ids zijn groot)
  accessToken  String
  refreshToken String
  expiresAt    DateTime // vervaltijd van het access-token
  scope        String? // toegekende OAuth-scopes (bv. "read,activity:read_all")
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([athleteId])
  @@map("strava_connections")
}

/// Eén nacht slaap, geaggregeerd uit HealthKit sleep-analysis-segmenten.
/// `date` = start-of-day van de ochtend (1 per user per nacht).
model SleepEntry {
  id           String        @id @default(cuid())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  date         DateTime
  startAt      DateTime // bedtijd (eerste segment)
  endAt        DateTime // ontwaaktijd (laatste segment)
  inBedMin     Int? // totaal in bed
  asleepMin    Int // totale slaaptijd (TST)
  awakeMin     Int           @default(0) // WASO + wakker na inslapen
  lightMin     Int           @default(0)
  deepMin      Int           @default(0)
  remMin       Int           @default(0)
  efficiency   Float? // 0-1 = asleep / inBed
  latencyMin   Int? // inslaaptijd
  // Transparante 0-100 score (Fitbit-stijl: 50% duur, 25% herstellend
  // deep+REM, 25% efficiëntie). Opgeslagen voor trends, herberekenbaar.
  qualityScore Int?
  stages       Json? // hypnogram-segmenten: [{ stage, startAt, endAt }]
  source       WorkoutSource @default(APPLE_WATCH)
  // `externalId` uniek PER USER (niet globaal): voorkomt dat de HealthKit-UUID
  // van gebruiker A botst met een rij van gebruiker B (unique-constraint-500).
  externalId   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, date])
  @@unique([userId, externalId])
  @@index([userId, date])
  @@map("sleep_entries")
}

/// Dagelijkse fysiologische metingen (meestal nachtmeting). 1 per user per dag.
model VitalsEntry {
  id                 String        @id @default(cuid())
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  date               DateTime
  restingHeartRate   Int? // bpm
  hrv                Float? // ms
  hrvType            HrvType? // SDNN (Apple) vs RMSSD — nooit cross-device vergelijken
  respiratoryRate    Float? // ademhalingen/min (nachtelijk)
  wristTempDeviation Float? // °C afwijking van persoonlijke baseline (Series 8+)
  steps              Int? // dagelijks aantal stappen (HealthKit stepCount, dagsom)
  activeEnergyKcal   Int? // dagelijkse actieve verbranding in kcal (HealthKit activeEnergyBurned, dagsom)
  basalEnergyKcal    Int? // dagelijkse basaalverbranding in kcal (HealthKit basalEnergyBurned, dagsom); totaal = actief + basaal
  vo2Max             Float? // ml/kg/min — Apple cardio-fitness VO2max (één waarde, uit outdoor loop/wandel/hike)
  source             WorkoutSource @default(APPLE_WATCH)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("vitals_entries")
}

/// Dagelijkse stress-momentopname (Athlytic-stijl): cardiovasculaire "silent
/// workload" tijdens rust, 0–100 via %HRR (HR t.o.v. rust-HR), actieve/workout-
/// periodes uitgesloten. On-device berekend uit HealthKit HR-samples en compact
/// gesynct (dag-gemiddelde + gedownsamplede intraday-serie + tijd-in-band). Puur
/// welzijnssignaal, geen diagnose. Zie research-memo stress-meter.
model StressEntry {
  id               String        @id @default(cuid())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  date             DateTime // start-of-day, uniek per user
  avgScore         Int? // dag-gemiddelde 0–100 (alleen rust-periodes)
  restingHeartRate Int? // gebruikte rust-HR (bpm) die dag
  samples          Json? // gedownsamplede intraday-serie: [{ m: minutenVanafMiddernacht, v: 0–100 }]
  timeInBands      Json? // seconden per band: { low, moderate, elevated, high }
  source           WorkoutSource @default(APPLE_WATCH)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("stress_entries")
}

/// Dagelijkse momentopname van de hybride readiness-score. Bewaard voor trend
/// + cohort-aggregaten. `contributors` = breakdown per signaal met status
/// (above/within/below) en bijdrage.
model ReadinessSnapshot {
  id           String        @id @default(cuid())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  date         DateTime
  score        Int // 0-100
  band         ReadinessBand
  contributors Json
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("readiness_snapshots")
}
