# ─── Supabase (auth + database + storage) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Alleen server-side gebruiken — NOOIT in de client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Database (Prisma) ──────────────────────────────────────────────────────
# DATABASE_URL = pooled (pgbouncer) voor runtime; DIRECT_URL = direct voor migraties.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Security ───────────────────────────────────────────────────────────────
# Beschermt de cron-endpoints (Vercel injecteert dit als Bearer-token). Verplicht
# in productie, anders draaien de crons (gdpr-cleanup, compute-insights) niet.
CRON_SECRET=generate-a-random-32+char-secret
# HMAC-sleutel voor MFA-backupcodes. Verplicht in productie (geen fallback).
MFA_BACKUP_SALT=generate-a-strong-random-secret

# ─── AI (Anthropic) — concept-teksten test-/hardloopanalyse + shop-intake ─────
# Zie docs/avg-verwerkers.md voor de AVG-afspraken (DPA + zero retention).
ANTHROPIC_API_KEY=sk-ant-...
# Optioneel: override model voor het testrapport-concept (default claude-sonnet-4-6).
# TESTRAPPORT_AI_MODEL=claude-sonnet-4-6

# ─── E-mail (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
# Afzender-display, bv. "MBT Gym <noreply@mbt-gym.nl>".
RESEND_FROM=MBT Gym <noreply@mbt-gym.nl>

# ─── Rate limiting (Upstash Redis) — optioneel ──────────────────────────────
# Zonder deze valt rate-limiting terug op per-instance geheugen (niet betrouwbaar
# over meerdere serverless-instances). In productie aanraden om te zetten.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Error tracking (Sentry) — optioneel ────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# ─── Shop / betalingen (Mollie) — alleen voor het consumenten-shop-gedeelte ──
# MOLLIE_API_KEY=
# BOOKKEEPING_EMAIL=
# SHOP_PUBLIC=false
